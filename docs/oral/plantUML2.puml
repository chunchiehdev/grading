  @startuml
  skinparam packageStyle rectangle
  skinparam usecase {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
  }
  skinparam actorStyle awesome

  left to right direction

  actor "教師" as teacher

  rectangle "教師課程管理與檢視" {
    usecase "建立課程" as UC1
    usecase "填寫課程資訊" as UC1a

    usecase "建立班級" as UC2
    usecase "設定班級資訊" as UC2a

    usecase "產生邀請碼" as UC3

    usecase "設定評分規準" as UC4
    usecase "建立或選用規準" as UC4a

    usecase "建立作業" as UC5
    usecase "填寫作業內容" as UC5a
    usecase "連結評分規準" as UC5b

    usecase "檢視課程與班級" as UC6
    usecase "檢視學生名單" as UC7
  }

  teacher --> UC1
  teacher --> UC2
  teacher --> UC3
  teacher --> UC4
  teacher --> UC5
  teacher --> UC6
  teacher --> UC7

  UC1 ..> UC1a : <<include>>
  UC2 ..> UC2a : <<include>>
  UC4 ..> UC4a : <<include>>
  UC5 ..> UC5a : <<include>>
  UC5 ..> UC5b : <<include>>

  @enduml